  canvasDialogUtama: {fileID: 1924195446}
  tempatTeksDialog: {fileID: 1766360858}
  semuaBubleNama:
  - {fileID: 1547485099}
  popupInteraksiNPC: {fileID: 0}
  percakapan:
  - bubleNamaAktif: {fileID: 1547485099}
    namaKarakter: Nathan
    teksDialog: "Kalau aku menerima pekerjaan ini, hidupku akan terjamin\u2026"
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 1547485099}
    namaKarakter: Nathan
    teksDialog: Gaji tinggi, masa depan yang jelas.
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 1547485099}
    namaKarakter: Nathan
    teksDialog: "Tapi desa ini\u2026 lihatlah sekeliling. Anak-anak muda sudah pergi
      semua."
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 1547485099}
    namaKarakter: Nathan
    teksDialog: Rumah-rumah sudah rusak, ladang-ladang terbengkalai, pasar sepi,
      hanya orang tua yang tersisa.
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 1547485099}
    namaKarakter: Nathan
    teksDialog: Kalau aku pergi, siapa yang akan membangun desa ini?
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 1547485099}
    namaKarakter: Nathan
    teksDialog: Dan kalau aku bertahan? apa aku bisa melakukan ini sendirian? aku
      tidak punya modal yang besar, sementara kebutuhan hidup semakin naik.
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 1547485099}
    namaKarakter: Nathan
    teksDialog: Tapi, paman percaya kepadaku, masa aku tega dan membiarkan yang lain
      begitu saja?
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 1547485099}
    namaKarakter: Nathan
    teksDialog: ...
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 1547485099}
    namaKarakter: Nathan
    teksDialog: "Aku\u2026 tidak tahu. Aku tidak tahu\u2026"
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 122775549}
