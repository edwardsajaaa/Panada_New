  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 97891636}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e4987bffc90f0524a93b569a43ebcfc4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  bubleDialogUtama: {fileID: 1278348271}
  canvasDialogUtama: {fileID: 1924195446}
  tempatTeksDialog: {fileID: 1766360858}
  semuaBubleNama:
  - {fileID: 1547485099}
  - {fileID: 118121464}
  popupInteraksiNPC: {fileID: 404878841}
  percakapan:
  - bubleNamaAktif: {fileID: 1547485099}
    namaKarakter: Nathan
    teksDialog: Halo paman selamat siang. Sudah lama tidak bertemu
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 118121464}
    namaKarakter: Paman
    teksDialog: eh Nathan... akhirnya kamu benar benar datang
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 118121464}
    namaKarakter: Paman
    teksDialog: Sudah lama kami menunggu momen seperti ini.
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 1547485099}
    namaKarakter: Nathan
    teksDialog: ah iya paman, sebenarnya apa yang terjadi di desa selama beberapa
      tahun ini?
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 118121464}
    namaKarakter: Paman
    teksDialog: 'Desa kami yang tercinta... sekarang seperti tubuh yang kehilangan
      nadinya '
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 118121464}
    namaKarakter: Paman
    teksDialog: 'Banyak yang pergi, sedikit yang kembali. '
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 118121464}
    namaKarakter: Paman
    teksDialog: Rumah-rumah kosong, sawah yang terbengkalai, dan pasar yang dahulu
      ramai kini hanya tinggal kenangan.
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 118121464}
    namaKarakter: Paman
    teksDialog: Kami membutuhkan perubahan, Nathan. Kami membutuhkanmu.
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 118121464}
    namaKarakter: Paman
    teksDialog: Tapi kami juga tahu... tidak mudah memilih jalan kembali.
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 118121464}
    namaKarakter: Paman
    teksDialog: Namun kami tidak bisa memaksamu
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 118121464}
    namaKarakter: Paman
    teksDialog: Semua kembali ke dalam dirimu untuk memutuskan
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 1547485099}
    namaKarakter: Nathan
    teksDialog: Baiklah aku mengerti paman dengan masalah yang dihadapi sekarang.
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 1547485099}
    namaKarakter: Nathan
    teksDialog: Tapi saat ini aku harus pertimbangkan terlebih dahulu
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 118121464}
    namaKarakter: Paman
    teksDialog: Baiklah, paman mengerti..
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 118121464}
    namaKarakter: Paman
    teksDialog: masih ada waktu untuk memutuskan. oiya keluargamu sudah menunggumu
      di rumah
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
  - bubleNamaAktif: {fileID: 1547485099}
    namaKarakter: Nathan
    teksDialog: Oiya baiklah paman aku permisi dulu kalo gitu
    saatBarisMulai:
      m_PersistentCalls:
        m_Calls: []
